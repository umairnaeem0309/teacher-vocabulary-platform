# Development environment for the English-Polish Vocabulary Platform.
# Copy to .env and adjust. NEVER commit the real .env file.

# --- Application ---
APP_ENV=development
# Console (human-readable) or JSON (structured, one object per line)
LOG_FORMAT=console
LOG_LEVEL=INFO

# --- Database (PostgreSQL 17, native Windows install) ---
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/vocab_platform

# --- Frontend ---
# Next.js API base URL (server components / route handlers)
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- CORS ---
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# --- Security hardening (Phase 23) ---
# Origins allowed to make state-changing (POST/PUT/PATCH/DELETE) requests
# when the browser sends an Origin header (CSRF defense). Empty disables
# the check (pure non-browser API use; not recommended with cookie auth).
ALLOWED_REQUEST_ORIGINS=http://localhost:3000
# Sliding-window rate limits (per client IP; 0 disables limiting).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=300
RATE_LIMIT_READ_MAX=240
RATE_LIMIT_READ_WINDOW_SECONDS=60
RATE_LIMIT_WRITE_MAX=120
RATE_LIMIT_WRITE_WINDOW_SECONDS=60
RATE_LIMIT_UPLOAD_MAX=20
# Hard cap on uploaded import-file size, in bytes (default 5 MiB).
UPLOAD_MAX_BYTES=5242880

# --- Embeddings (Phase 12; locked decision: BAAI/bge-m3) ---
EMBEDDING_MODEL=BAAI/bge-m3
VECTOR_DIMENSION=1024
# Load the model at startup (background) so the first search is not slow.
EMBEDDING_WARMUP=true

# --- Sessions / auth (Phase 15) ---
# Bootstrap: POST /api/v1/auth/bootstrap creates the FIRST teacher only;
# the window closes forever once a teacher exists. No public registration.
# Phase 23: the placeholder below is REJECTED when APP_ENV is production
# or staging — set a strong random value there.
SESSION_SECRET=change-me-in-later-phases
# Session lifetime is fixed in code (app/core/auth.py SESSION_TTL, 24h).
