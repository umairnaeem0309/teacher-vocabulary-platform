# Development environment for the English-Polish Vocabulary Platform.
# Copy to .env and adjust. NEVER commit the real .env file.

# --- Application ---
APP_ENV=development

# --- Database (PostgreSQL 17, native Windows install) ---
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/vocab_platform

# --- Frontend ---
# Next.js API base URL (server components / route handlers)
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- CORS ---
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# --- Embeddings (Phase 12; locked decision: BAAI/bge-m3) ---
EMBEDDING_MODEL=BAAI/bge-m3
VECTOR_DIMENSION=1024

# --- Sessions / auth (Phase 15) ---
SESSION_SECRET=change-me-in-later-phases
