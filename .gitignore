# --- Data ---
# Raw source datasets are large (wiktextract dump is ~2.7 GB) and are kept out
# of version control on purpose. Provenance, versions and download sources are
# documented in data/raw/README.md. Raw data must never be modified.
data/raw/*
!data/raw/README.md
data/intermediate/
data/processed/
data/embeddings/
data/construction/
data/source-inventory.json
# Local PostgreSQL backups (Phase 26) contain the full live database — never commit.
data/backups/

# --- SQLite construction databases ---
*.sqlite
*.sqlite3
*.db

# --- Embedding model caches ---
models/
.cache/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Tool metadata ---
.freebuff/

# --- Logs ---
*.log
logs/


